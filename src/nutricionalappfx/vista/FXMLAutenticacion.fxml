<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLAutenticacionController">
   <children>
      <VBox fx:id="vBoxImagen" layoutX="9.0" layoutY="6.0" prefHeight="256.0" prefWidth="251.0">
         <children>
            <ImageView fx:id="imagenFondo" fitHeight="266.0" fitWidth="251.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../recurso/logo.jpg" />
               </image>
            </ImageView>
         </children>
      </VBox>
      
      <TextField fx:id="tfUsuario" layoutX="282.0" layoutY="125.0" prefHeight="31.0" prefWidth="275.0" promptText="Ingrese su No. Personal" />
      <PasswordField fx:id="tfContrasenia" layoutX="281.0" layoutY="201.0" prefHeight="31.0" prefWidth="275.0" promptText="Ingrese su contraseña" />
      
      <Label fx:id="txtErrorUsuario" layoutX="282.0" layoutY="156.0" prefHeight="21.0" prefWidth="275.0" textFill="#d30000" />
      <Label fx:id="txtErrorContrasenia" layoutX="282.0" layoutY="232.0" prefHeight="21.0" prefWidth="275.0" textFill="#d30000" />
      
      <Button layoutX="387.0" layoutY="277.0" mnemonicParsing="false" onAction="#handleBtnIngresar" text="Ingresar" textFill="#1b1b1b">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
      
      <Label contentDisplay="CENTER" graphicTextGap="6.0" layoutX="343.0" layoutY="47.0" prefHeight="53.0" prefWidth="153.0" text="NutriApp" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS">
         <effect>
            <Glow />
         </effect>
         <font>
            <Font size="36.0" />
         </font>
      </Label>
   </children>
</AnchorPane>